with "config/horizon_vga_config.gpr";
project Horizon_Vga is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Horizon_Vga_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("horizon_vga.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatyM120");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Horizon_Vga;
